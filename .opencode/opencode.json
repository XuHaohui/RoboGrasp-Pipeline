{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/RULES.md"],
  "permission": {
    "edit": {
      "*": "allow",
      ".git/**": "deny",
      ".opencode/**": "deny"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "git *": "deny"
    },
    "webfetch": "allow",
    "todowrite": "allow",
    "question": "allow"
  }
}
